{
  "title": "Registro de Recogida de Menores",
  "description": "",
  "head": "<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />",
  "htmlAttrs": "lang=\"en\" class=\"\"",
  "tags": [],
  "activeEditor": "markup",
  "markup": {
    "language": "html",
    "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Seguridad - Recogida de Menores</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js\"></script>\r\n    <style>\r\n        .signature-pad { border: 2px dashed #cbd5e1; cursor: crosshair; touch-action: none; }\r\n        .modal { transition: all 0.3s ease; }\r\n        body.modal-active { overflow: hidden; }\r\n        .input-field { @apply w-full px-4 py-3 rounded-sm bg-slate-50 border-2 border-transparent focus:border-indigo-500 focus:bg-white transition-all outline-none; }\r\n    </style>\r\n</head>\r\n<body class=\"bg-slate-100 min-h-screen p-4 md:p-10 font-sans text-slate-700\">\r\n    <div class=\"max-w-6xl mx-auto\">\r\n        <header class=\"flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 bg-white p-6 rounded-sm shadow-sm border border-slate-200\">\r\n            <div>\r\n                <h1 class=\"text-2xl font-extrabold text-slate-900 tracking-tight\">Registro de Recogida de Menores</h1>\r\n                <p class=\"text-slate-500 text-sm\">Panel de control de seguridad y trazabilidad.</p>\r\n            </div>\r\n            <div class=\"flex gap-3\">\r\n                <button onclick=\"toggleModal()\" class=\"bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-sm font-bold transition-all shadow-lg shadow-indigo-200 flex items-center gap-2\">\r\n                    <span>+ Nueva Recogida</span>\r\n                </button>\r\n                <button onclick=\"exportToExcel()\" class=\"bg-emerald-500 hover:bg-emerald-600 text-white px-6 py-3 rounded-sm font-bold transition-all shadow-lg shadow-emerald-200 flex items-center gap-2\">\r\n                    <span>Exportar Excel</span>\r\n                </button>\r\n            </div>\r\n        </header>\r\n\r\n        <div class=\"bg-white rounded-sm shadow-sm border border-slate-200 overflow-hidden\">\r\n            <div class=\"overflow-x-auto\">\r\n                <table class=\"w-full text-left border-collapse\">\r\n                    <thead class=\"bg-slate-50 border-b border-slate-100\">\r\n                        <tr>\r\n                            <th class=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider\">Fecha / Hora</th>\r\n                            <th class=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider\">Menor</th>\r\n                            <th class=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider\">Recoge / DNI</th>\r\n                            <th class=\"px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider text-center\">Firma</th>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody id=\"tableBody\" class=\"divide-y divide-slate-100\">\r\n                        </tbody>\r\n                </table>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"modal\" class=\"modal opacity-0 pointer-events-none fixed inset-0 flex items-center justify-center z-50 p-4\">\r\n        <div class=\"absolute inset-0 bg-slate-900/40 backdrop-blur-sm\" onclick=\"toggleModal()\"></div>\r\n        \r\n        <div class=\"bg-white w-full max-w-2xl rounded-sm shadow-2xl z-50 overflow-hidden\">\r\n            <div class=\"p-8\">\r\n                <div class=\"flex justify-between items-center mb-8\">\r\n                    <h3 class=\"text-2xl font-bold text-slate-800\">Formulario de Entrega</h3>\r\n                    <button onclick=\"toggleModal()\" class=\"text-slate-400 hover:text-slate-600 transition-colors text-2xl font-light\">✕</button>\r\n                </div>\r\n\r\n                <form id=\"deliveryForm\" class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\r\n                    <div class=\"md:col-span-2\">\r\n                        <label class=\"block text-xs font-bold text-slate-400 uppercase mb-1 ml-1\">A quién recoge (Menor)</label>\r\n                        <input type=\"text\" id=\"minor\" required placeholder=\"Nombre completo del menor\" class=\"w-full px-4 py-3 rounded-sm bg-slate-50 border-2 border-transparent focus:border-indigo-500 focus:bg-white transition-all outline-none\">\r\n                    </div>\r\n\r\n                    <div>\r\n                        <label class=\"block text-xs font-bold text-slate-400 uppercase mb-1 ml-1\">Persona que recoge</label>\r\n                        <input type=\"text\" id=\"adult\" required placeholder=\"Nombre y apellidos\" class=\"w-full px-4 py-3 rounded-sm bg-slate-50 border-2 border-transparent focus:border-indigo-500 focus:bg-white transition-all outline-none\">\r\n                    </div>\r\n\r\n                    <div>\r\n                        <label class=\"block text-xs font-bold text-slate-400 uppercase mb-1 ml-1\">DNI / Documento</label>\r\n                        <input type=\"text\" id=\"dni\" required placeholder=\"Número de identidad\" class=\"w-full px-4 py-3 rounded-sm bg-slate-50 border-2 border-transparent focus:border-indigo-500 focus:bg-white transition-all outline-none\">\r\n                    </div>\r\n\r\n                    <div>\r\n                        <label class=\"block text-xs font-bold text-slate-400 uppercase mb-1 ml-1\">Fecha</label>\r\n                        <input type=\"date\" id=\"date\" required class=\"w-full px-4 py-3 rounded-sm bg-slate-50 border-2 border-transparent focus:border-indigo-500 focus:bg-white transition-all outline-none\">\r\n                    </div>\r\n\r\n                    <div>\r\n                        <label class=\"block text-xs font-bold text-slate-400 uppercase mb-1 ml-1\">Hora</label>\r\n                        <input type=\"time\" id=\"time\" required class=\"w-full px-4 py-3 rounded-sm bg-slate-50 border-2 border-transparent focus:border-indigo-500 focus:bg-white transition-all outline-none\">\r\n                    </div>\r\n\r\n                    <div class=\"md:col-span-2\">\r\n                        <div class=\"flex justify-between items-end mb-2\">\r\n                            <label class=\"text-xs font-bold text-slate-400 uppercase ml-1\">Firma de Conformidad</label>\r\n                            <button type=\"button\" id=\"clearBtn\" class=\"text-xs text-rose-500 font-bold hover:underline\">Limpiar Firma</button>\r\n                        </div>\r\n                        <canvas id=\"signatureCanvas\" class=\"signature-pad w-full h-40 bg-slate-50 rounded-sm\"></canvas>\r\n                    </div>\r\n\r\n                    <button type=\"submit\" class=\"md:col-span-2 mt-4 bg-indigo-600 text-white font-bold py-4 rounded-sm hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-100\">\r\n                        Finalizar y Registrar\r\n                    </button>\r\n                </form>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        // DB Init\r\n        let db;\r\n        const request = indexedDB.open(\"SeguridadMenoresDB\", 1);\r\n        request.onupgradeneeded = (e) => {\r\n            db = e.target.result;\r\n            db.createObjectStore(\"entregas\", { keyPath: \"id\", autoIncrement: true });\r\n        };\r\n        request.onsuccess = (e) => { db = e.target.result; loadTable(); };\r\n\r\n        // Signature Logic\r\n        const canvas = document.getElementById('signatureCanvas');\r\n        const ctx = canvas.getContext('2d');\r\n        let writing = false;\r\n\r\n        function setupCanvas() {\r\n            const rect = canvas.getBoundingClientRect();\r\n            canvas.width = rect.width;\r\n            canvas.height = rect.height;\r\n            ctx.strokeStyle = \"#1e293b\"; ctx.lineWidth = 3; ctx.lineCap = \"round\";\r\n        }\r\n\r\n        const getPos = (e) => {\r\n            const rect = canvas.getBoundingClientRect();\r\n            const clientX = e.clientX || (e.touches && e.touches[0].clientX);\r\n            const clientY = e.clientY || (e.touches && e.touches[0].clientY);\r\n            return { x: clientX - rect.left, y: clientY - rect.top };\r\n        };\r\n\r\n        const startDraw = (e) => { writing = true; ctx.beginPath(); const p = getPos(e); ctx.moveTo(p.x, p.y); };\r\n        const draw = (e) => { if(!writing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); };\r\n        const endDraw = () => writing = false;\r\n\r\n        canvas.addEventListener('mousedown', startDraw);\r\n        canvas.addEventListener('mousemove', draw);\r\n        window.addEventListener('mouseup', endDraw);\r\n        canvas.addEventListener('touchstart', (e) => { e.preventDefault(); startDraw(e); });\r\n        canvas.addEventListener('touchmove', (e) => { e.preventDefault(); draw(e); });\r\n\r\n        document.getElementById('clearBtn').onclick = () => ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n\r\n        // UI Logic\r\n        function toggleModal() {\r\n            const modal = document.getElementById('modal');\r\n            modal.classList.toggle('opacity-0');\r\n            modal.classList.toggle('pointer-events-none');\r\n            document.body.classList.toggle('modal-active');\r\n            \r\n            if(!modal.classList.contains('opacity-0')) {\r\n                const now = new Date();\r\n                document.getElementById('date').valueAsDate = now;\r\n                document.getElementById('time').value = now.toLocaleTimeString('en-GB', {hour: '2-digit', minute:'2-digit'});\r\n                setTimeout(setupCanvas, 50);\r\n            }\r\n        }\r\n\r\n        async function loadTable() {\r\n            const transaction = db.transaction([\"entregas\"], \"readonly\");\r\n            const data = transaction.objectStore(\"entregas\").getAll();\r\n\r\n            data.onsuccess = () => {\r\n                const tbody = document.getElementById('tableBody');\r\n                tbody.innerHTML = data.result.reverse().map(reg => `\r\n                    <tr class=\"hover:bg-slate-50/80 transition-all\">\r\n                        <td class=\"px-6 py-4\">\r\n                            <div class=\"text-sm font-bold text-slate-800\">${reg.fecha}</div>\r\n                            <div class=\"text-xs text-slate-400 font-medium\">${reg.hora}</div>\r\n                        </td>\r\n                        <td class=\"px-6 py-4 font-bold text-indigo-600\">${reg.menor}</td>\r\n                        <td class=\"px-6 py-4\">\r\n                            <div class=\"text-sm font-semibold text-slate-800\">${reg.adulto}</div>\r\n                            <div class=\"text-xs text-slate-400\">${reg.dni}</div>\r\n                        </td>\r\n                        <td class=\"px-6 py-4 text-center\">\r\n                            <img src=\"${reg.firma}\" class=\"h-10 mx-auto bg-white rounded border border-slate-100 p-1\">\r\n                        </td>\r\n                    </tr>\r\n                `).join('');\r\n            };\r\n        }\r\n\r\n        document.getElementById('deliveryForm').onsubmit = (e) => {\r\n            e.preventDefault();\r\n            const record = {\r\n                menor: document.getElementById('minor').value,\r\n                adulto: document.getElementById('adult').value,\r\n                dni: document.getElementById('dni').value,\r\n                fecha: document.getElementById('date').value,\r\n                hora: document.getElementById('time').value,\r\n                firma: canvas.toDataURL()\r\n            };\r\n\r\n            const tx = db.transaction([\"entregas\"], \"readwrite\");\r\n            tx.objectStore(\"entregas\").add(record);\r\n            tx.oncomplete = () => {\r\n                loadTable();\r\n                toggleModal();\r\n                e.target.reset();\r\n            };\r\n        };\r\n\r\n        // Advanced Excel Export with Images\r\n        async function exportToExcel() {\r\n            const workbook = new ExcelJS.Workbook();\r\n            const sheet = workbook.addWorksheet('Recogidas');\r\n\r\n            sheet.columns = [\r\n                { header: 'Fecha', key: 'fecha', width: 15 },\r\n                { header: 'Hora', key: 'hora', width: 10 },\r\n                { header: 'Menor', key: 'menor', width: 25 },\r\n                { header: 'Recoge', key: 'adulto', width: 25 },\r\n                { header: 'DNI', key: 'dni', width: 15 },\r\n                { header: 'Firma Responsable', key: 'firma', width: 30 }\r\n            ];\r\n\r\n            const transaction = db.transaction([\"entregas\"], \"readonly\");\r\n            const registros = await new Promise(res => {\r\n                transaction.objectStore(\"entregas\").getAll().onsuccess = (e) => res(e.target.result);\r\n            });\r\n\r\n            for (let i = 0; i < registros.length; i++) {\r\n                const r = registros[i];\r\n                const rowNumber = i + 2;\r\n                sheet.addRow(r);\r\n\r\n                const imageId = workbook.addImage({\r\n                    base64: r.firma,\r\n                    extension: 'png'\r\n                });\r\n\r\n                sheet.addImage(imageId, {\r\n                    tl: { col: 5, row: rowNumber - 1 },\r\n                    ext: { width: 120, height: 45 }\r\n                });\r\n                sheet.getRow(rowNumber).height = 40;\r\n            }\r\n\r\n            const buffer = await workbook.xlsx.writeBuffer();\r\n            const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });\r\n            const link = document.createElement('a');\r\n            link.href = URL.createObjectURL(blob);\r\n            link.download = `Registro_Recogidas_${new Date().toLocaleDateString()}.xlsx`;\r\n            link.click();\r\n        }\r\n    </script>\r\n</body>\r\n</html>"
  },
